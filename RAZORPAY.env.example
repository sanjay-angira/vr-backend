# Razorpay (add these to vr-backend/.env)
# Dashboard: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Webhook URL to paste in Razorpay Dashboard → Settings → Webhooks:
# Local:      http://localhost:8080/backend/api/customer/payments/razorpay/webhook
# Production: https://api.vrindavanrasa.com/backend/api/customer/payments/razorpay/webhook
# Events: payment.captured, payment.failed
